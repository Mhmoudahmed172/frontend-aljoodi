# Backend base URL (no trailing slash). Laravel API routes live under `/api/*`
# (`routes/api.php` is loaded under `Route::prefix('api')`), so this is the bare host —
# `api.*` calls that hit `routes/api.php` (auth, public `/v1/*` catalog) pass their own
# `/api/...` prefix; `/admin`, `/instructor`, `/user` routes are separate top-level groups
# and don't need it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only override of the URL Next.js's Route Handlers (session BFF, /api/proxy) use to
# reach Laravel. Only needed when the Next.js server reaches the backend differently than the
# browser does (e.g. an internal Docker service name vs. a public host) — defaults to
# NEXT_PUBLIC_API_URL when unset.
API_INTERNAL_URL=http://localhost:8000
# Separate dashboard app (app-dashboard, Vite) — target of the "لوحة التحكم" header link
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5170
# Name of the httpOnly cookie that stores the Passport access token (see
# src/app/api/session/{login,logout}/route.ts, src/app/api/proxy/[...path]/route.ts, src/proxy.ts).
SESSION_COOKIE_NAME=session_token
# Cloudflare Turnstile site key (public). Shown on register/forgot-password/OTP-resend to protect
# those SMS-sending endpoints from abuse — the backend verifies the token with the matching secret
# (`CAPTCHA_SECRET` in app-backend/.env). Leave unset to render no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google OAuth web client id (public). Optional override of the built-in platform client id (see useGoogleLogin).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
